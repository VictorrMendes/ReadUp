# Copie para .env. Use apenas letras e números (a senha entra na URL de conexão).
POSTGRES_PASSWORD=
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Opcional: email de contato do dono do app para a API de tradução MyMemory (aumenta a cota
# diária de 5 mil para 50 mil caracteres). Nunca o email de um usuário.
MYMEMORY_EMAIL=
# Notícias (VOA Learning English e Wikinews): busca automática dentro da API a cada N horas.
# Padrão 6; 0 desliga. Para buscar na hora: docker compose exec api python -m app.news.fetch
NEWS_FETCH_HOURS=6
# Opcional: URL ou email de contato do dono do app no User-Agent da busca de notícias (a
# política da Wikimedia pede contato; sem ele a busca da Wikinews fica mais lenta, 1 página a
# cada 7 s). Nunca o email de um usuário.
NEWS_CONTACT=
